[Unit]
Description=Frau Liu Django (Gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/projects/frau-liu-learn-german
EnvironmentFile=/srv/projects/frau-liu-learn-german/.env
ExecStart=/srv/projects/frau-liu-learn-german/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 5 --timeout 60 --keep-alive 2 --max-requests 1000 --max-requests-jitter 50
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=70
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
